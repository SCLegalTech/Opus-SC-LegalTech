# Opus SC LegalTech MCP Server
# Copiar a .env y completar los valores reales.

# URL base de la API v1 del backend (sin barra final)
MCP_API_URL=http://localhost:4000/api/v1

# JWT del usuario que actuará como agente.
# Obtenerlo con: POST /api/auth/login → { token }
# Recomendado: crear un usuario de servicio (ej. agent@sclegaltech.com, role=admin)
MCP_API_TOKEN=

# Token servidor-servidor requerido para MCP_TRANSPORT=http.
# Debe coincidir con MCP_HTTP_AUTH_TOKEN del backend.
MCP_HTTP_AUTH_TOKEN=

# Origenes browser permitidos para CORS. En produccion normalmente queda vacio
# porque solo el backend debe hablar con mcp-server por red privada.
MCP_CORS_ORIGINS=

# Transporte a usar: "stdio" (Claude Desktop) | "http" (agente web)
MCP_TRANSPORT=stdio

# Solo relevante cuando MCP_TRANSPORT=http
MCP_HTTP_PORT=4001
