# Opus public self-hosted environment
# Copy as .env and set real values before running.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=opus
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false

PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-32-byte-secret

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
AGENT_DATA_API_BASE_URL=http://127.0.0.1:4000/api

AI_STRICT=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434

MCP_API_TOKEN=
MCP_HTTP_AUTH_TOKEN=
MCP_SERVER_URL=http://mcp-server:4001
MCP_CLIENT_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/auth/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v20.0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Opus SC LegalTech <no-reply@example.com>

LEGAL_NOTIFICATIONS_EMAIL=legal@example.com
LEGAL_CONTACT_EMAIL=contact@example.com
MCP_SERVER_STATUS_URL=http://mcp-server:4001
